@using GeotecnologiaKNS.Views;
@using Microsoft.Extensions.Options
@model GeotecnologiaKNS.Models.Solicitacao
@inject GeotecnologiaKNS.Repositories.Interfaces.ISolicitacaoRepository repository
@inject IOptions<GoogleMapsOptions> googleMaps

@{
    var maps = googleMaps.Value;
    var apiKey = maps.ApiKey;

    var perimetro = Model.Propriedade is null
        ? new PerimetroMapaViewModel()
        : PerimetroMapaViewModel.DaPropriedade(Model.Propriedade);
}

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://polyfill.io/v3/polyfill.min.js?features=default"></script>
    <style>
        #map {
            height: 100%;
        }

        html,
        body {
            height: 100%;
            margin: 0;
            padding: 0;
        }
    </style>
</head>

<div class="row">
    <div class="col-md-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <!-- Grupo 1 -->
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="Propriedade.Produtor.Nome" class="control-label"></label>
                            <div>@Model.Propriedade.Produtor.Nome</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="Propriedade.NomePropriedade" class="control-label"></label>
                            <div>@Model.Propriedade.NomePropriedade</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group select-with-icon">
                            <label asp-for="Propriedade.Bioma" class="control-label"></label>
                            <div>@Model.Propriedade.Bioma</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="Propriedade.UnidadeFederativa" class="control-label"></label>
                            <div>@Model.Propriedade.UnidadeFederativa</div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="Propriedade.Municipio" class="control-label"></label>
                            <div>@Model.Propriedade.Municipio</div>
                        </div>
                    </div>
                    <!-- Adicionando mais campos -->
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="Propriedade.Latitude" class="control-label"></label>
                            <div>@Model.Propriedade.Latitude</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="Propriedade.Longitude" class="control-label"></label>
                            <div>@Model.Propriedade.Longitude</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="Propriedade.Area" class="control-label"></label>
                            <div>@Model.Propriedade.Area</div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="Propriedade.AreaUtil" class="control-label"></label>
                            <div>@Model.Propriedade.AreaUtil</div>
                        </div>
                    </div>
                    <!-- Adicionando mais campos -->
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="Propriedade.Produtor.Cpf" class="control-label"></label>
                            <div>@Model.Propriedade.Produtor.Cpf</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="Propriedade.CicloProducao" class="control-label"></label>
                            <div>@Model.Propriedade.CicloProducao</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="Propriedade.TipoPropriedade" class="control-label"></label>
                            <div>@Model.Propriedade.TipoPropriedade</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




<div class="row">
    <div class="col-md-12 grid-margin stretch-card">
        @if (ViewBag.Analise is GeotecnologiaKNS.Models.AnaliseAutomatica analise)
        {
            <partial name="_analise" model="analise" />
        }
        else
        {
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        @Html.DisplayStatus(Model.Status)
                    </div>
                    <p class="text-muted mt-2 mb-0">
                        Esta solicitação não tem análise automática registrada.
                    </p>
                </div>
            </div>
        }
    </div>
</div>
<div class="row">

    <div class="col-md-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">


                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <h5 class="text-center">Protocolo</h5>
                    <div class="form-group">

                        <div class="form-group">
                            <label class="control-label">Tipo do protocolo</label>
                            <p>ANÁLISE DE RISCO</p>
                        </div>
                        <div class="form-group">
                            <label class="control-label">Critérios do protocolo</label>
                            <div class="row">
                                <div class="col-md-6">
                                    <ol>
                                        <li>Lista Suja do Trabalho Escravo - MTE</li>
                                        <li>Lista Áreas Embargadas - IBAMA</li>
                                        <li>Lista Desmatamento Ilegal- LDI-PA</li>
                                        <li>Unidade conservação</li>
                                        <li>Quilombolas</li>
                                        <li>SICAR</li>
                                        <li>Comprovantes de vínculos</li>
                                        <li>Licença ambienta rural</li>
                                    </ol>
                                </div>
                                <div class="col-md-6">
                                    <ol start="9">
                                        <li>Histórico de SICAR</li>
                                        <li>PRODES Amazônico</li>
                                        <li>Embargos IBAMA Polígonos</li>
                                        <li>Terras Indígenas</li>
                                        <li>Embargos Semas - MT</li>
                                        <li>Embargos LDI Semas - PA</li>
                                        <li>Obrigatoriedade Proprietário</li>
                                        <li>Valida Data Viculo</li>
                                    </ol>
                                </div>
                            </div>

                        </div>
                    </div>
                    <h5 class="text-center">Dados da solicitação</h5>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="Propriedade.NomePropriedade" class="control-label"></label>
                            <input asp-for="Propriedade.NomePropriedade" class="form-control" disabled />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="Analista" class="control-label"></label>
                            <input asp-for="Analista" class="form-control" disabled />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="Solicitante" class="control-label"></label>
                            <input asp-for="Solicitante" class="form-control" disabled />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="DataSolicitacao" class="control-label"></label>
                            <input asp-for="DataSolicitacao" class="form-control" disabled />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="DataAnalise" class="control-label"></label>
                            <input asp-for="DataAnalise" class="form-control" disabled />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="Observacao" class="control-label"></label>
                            <input asp-for="Observacao" class="form-control" disabled />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <partial name="_perimetro" model="perimetro" />

                <div class="row">
                    <h5 class="text-center" style="margin-top: 20px;">Parecer</h5>
                    <div class="col-md-12">
                        <div class="form-group">
                            <div class="text-center" style="margin-top: 10px;">@Model.Parecer</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <ul class="nav nav-tabs" id="myTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="home-tab" data-bs-toggle="tab" data-bs-target="#home" type="button" role="tab" aria-controls="home" aria-selected="true">Solicitações</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="prod-tab" data-bs-toggle="tab" data-bs-target="#prod" type="button" role="tab" aria-controls="prod" aria-selected="false">Produtor vinculado</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile" type="button" role="tab" aria-controls="profile" aria-selected="false">Propriedade vinculada</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="contact-tab" data-bs-toggle="tab" data-bs-target="#contact" type="button" role="tab" aria-controls="contact" aria-selected="false">Doc. Propriedade</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="doc-tab" data-bs-toggle="tab" data-bs-target="#doc" type="button" role="tab" aria-controls="doc" aria-selected="false">Doc. Produtor</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="analise-tab" data-bs-toggle="tab" data-bs-target="#analise" type="button" role="tab" aria-controls="analise" aria-selected="false">Doc. Análise</button>
                    </li>
                </ul>
                <div class="tab-content" id="myTabContent">
                    <div class="tab-pane fade show active" id="home" role="tabpanel" aria-labelledby="home-tab">
                        <partial name="_listaSolicitacoes" model="repository.GetSolicitacoesByProdutor(Model.Propriedade.Produtor.Id).Where(x => x != Model)"></partial>
                    </div>
                    <div class="tab-pane fade" id="prod" role="tabpanel" aria-labelledby="prod-tab">
                        <partial name="_propriedadeProdutor" model="Model.Propriedade.Produtor"></partial>
                    </div>
                    <div class="tab-pane fade" id="profile" role="tabpanel" aria-labelledby="profile-tab">
                        <partial name="_produtorPropriedade" model="Model.Propriedade.Produtor.Propriedades"></partial>
                    </div>
                    <div class="tab-pane fade" id="contact" role="tabpanel" aria-labelledby="contact-tab">
                        <partial name="_file-list" model="Model.Propriedade"></partial>
                    </div>
                    <div class="tab-pane fade" id="doc" role="tabpanel" aria-labelledby="doc-tab">
                        <partial name="_file-listP" model="Model.Propriedade.Produtor"></partial>
                    </div>
                    <div class="tab-pane fade" id="analise" role="tabpanel" aria-labelledby="analise-tab">
                        <partial name="_file-list-ADM" model="Model"></partial>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
