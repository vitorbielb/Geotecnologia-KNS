@using Microsoft.Extensions.Options
@model GeotecnologiaKNS.Models.Propriedade
@inject IOptions<GoogleMapsOptions> googleMaps

@{
    var maps = googleMaps.Value;
}

<div class="row">
    <div class="col-md-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Cadastrar Propriedade</h4>
                <p class="text-muted">
                    Informe o número do CAR. Área, município, UF, coordenadas e perímetro
                    são obtidos da base pública — não há o que digitar.
                </p>

                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group">
                                <label asp-for="CodigoCar" class="control-label"></label>
                                <div class="input-group">
                                    <input asp-for="CodigoCar" class="form-control"
                                           placeholder="MT-5107925-A1B2C3D4..." autocomplete="off" />
                                    <span class="input-group-append">
                                        <button class="btn btn-primary" type="button" id="btn-consultar-car">
                                            <i class="mdi mdi-magnify btn-icon-prepend"></i>
                                            Consultar
                                        </button>
                                    </span>
                                </div>
                                <span asp-validation-for="CodigoCar" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group select-with-icon">
                                <label asp-for="ProdutorId" class="control-label"></label>
                                <div class="select-wrapper">
                                    <select asp-for="ProdutorId" class="form-control form-control-sm" asp-items="ViewBag.Produtores"></select>
                                </div>
                                <span asp-validation-for="ProdutorId" class="error-message text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div id="car-mensagem"></div>

                    <div id="car-resultado" class="d-none">
                        <hr />
                        <h5 class="card-title">Dados obtidos da base do CAR</h5>

                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label class="control-label">Município / UF</label>
                                    <div id="car-municipio" class="fw-bold">-</div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label class="control-label">Área (ha)</label>
                                    <div id="car-area" class="fw-bold">-</div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label class="control-label">Situação no CAR</label>
                                    <div id="car-situacao" class="fw-bold">-</div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label class="control-label">Coordenadas do centro</label>
                                    <div id="car-centro" class="fw-bold">-</div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label class="control-label">Procedência</label>
                                    <div id="car-origem" class="text-muted">-</div>
                                </div>
                            </div>
                        </div>

                        @if (string.IsNullOrWhiteSpace(maps.ApiKey))
                        {
                            <div class="alert alert-warning">
                                Perímetro obtido, mas o mapa não pode ser exibido: a chave da API do
                                Google Maps não está configurada (<code>GoogleMaps:ApiKey</code>).
                            </div>
                        }
                        else
                        {
                            <div id="map" style="height: 380px;"></div>
                        }

                        <div class="form-group mt-3">
                            <label asp-for="NomePropriedade" class="control-label"></label>
                            <input asp-for="NomePropriedade" class="form-control"
                                   placeholder="Opcional — apelido interno para identificar o imóvel" />
                            <span asp-validation-for="NomePropriedade" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group" style="margin-top: 40px;">
                        <a href="/Propriedades/Index" class="btn btn-secondary">Voltar</a>
                    </div>

                    <div style="float: right; margin-top: -60px;">
                        <button type="submit" class="btn btn-primary gradient-button" id="btn-cadastrar" disabled>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
                                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
                            </svg>
                            Cadastrar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        window.googleMapsApiKey = @Json.Serialize(maps.ApiKey);
    </script>
    <script src="~/js/views/propriedades/create.js"></script>
}
