@using GeotecnologiaKNS.Views
@inject ISolicitacaoRepository repository

@{
    ViewData["Title"] = "Painel";

    var recentes = repository.GetRecentsSolicitacoes().ToList();

    var solicitados = recentes.Count(s => s.Status == Status.Solicitado);
    var liberados = recentes.Count(s => s.Status == Status.Liberado);
    var alerta = recentes.Count(s => s.Status == Status.Alerta);
    var bloqueados = recentes.Count(s => s.Status == Status.Bloqueado);
    var total = recentes.Count;
}

<div class="kns-cabecalho">
    <div>
        <h1 class="kns-cabecalho__titulo">Painel de análises</h1>
        <p class="kns-cabecalho__sub">
            Situação da carteira de imóveis monitorados e das solicitações mais recentes.
        </p>
    </div>
    <div class="kns-trilha">
        <i class="mdi mdi-home-outline"></i>
        <span>Início</span>
        <span>/</span>
        <span class="kns-trilha__atual">Painel</span>
    </div>
</div>

@* Indicadores primeiro: o operador precisa do veredito agregado antes do detalhe. *@
<div class="kns-indicadores">
    <div class="kns-indicador kns-indicador--liberado">
        <div class="kns-indicador__rotulo">Liberados</div>
        <div class="kns-indicador__valor">@liberados</div>
        <div class="kns-indicador__nota">Sem restrição identificada</div>
    </div>
    <div class="kns-indicador kns-indicador--alerta">
        <div class="kns-indicador__rotulo">Em alerta</div>
        <div class="kns-indicador__valor">@alerta</div>
        <div class="kns-indicador__nota">Exigem verificação</div>
    </div>
    <div class="kns-indicador kns-indicador--bloqueado">
        <div class="kns-indicador__rotulo">Bloqueados</div>
        <div class="kns-indicador__valor">@bloqueados</div>
        <div class="kns-indicador__nota">Aquisição vedada</div>
    </div>
    <div class="kns-indicador kns-indicador--solicitado">
        <div class="kns-indicador__rotulo">Aguardando análise</div>
        <div class="kns-indicador__valor">@solicitados</div>
        <div class="kns-indicador__nota">Na fila de processamento</div>
    </div>
</div>

@* Mapa em largura inteira: é a visão territorial da carteira e o elemento que
   mais se beneficia de área. *@
<div class="row">
    <div class="col-12 grid-margin">
        <div class="card">
            <partial name="_map" />
        </div>
    </div>
</div>

@* Abaixo, distribuição e lista dividindo a linha. *@
<div class="row">
    <div class="col-lg-5 grid-margin stretch-card">
        <div class="card">
            <div class="card-body d-flex flex-column">
                <h4 class="card-title">Distribuição por situação</h4>
                @if (total == 0)
                {
                    <p class="text-muted mb-0">Nenhuma solicitação registrada até o momento.</p>
                }
                else
                {
                    <div style="position: relative; flex: 1; min-height: 300px;">
                        <canvas id="barChart"></canvas>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-7 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="card-title mb-0">Solicitações recentes</h4>
                    <a href="@Url.Action("Index", "Solicitacoes")" class="btn btn-secondary btn-sm">
                        Ver todas
                    </a>
                </div>

                @if (total == 0)
                {
                    <p class="text-muted mb-0">Nada para exibir ainda.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>Imóvel</th>
                                    <th>Abertura</th>
                                    <th>Análise</th>
                                    <th>Situação</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in recentes)
                                {
                                    <tr class="table-row" data-url="@Url.Action("Details", "Solicitacoes", new { id = item.Id })">
                                        <td>@(item.Propriedade?.NomePropriedade ?? "—")</td>
                                        <td>@(item.DataSolicitacao?.ToString("dd/MM/yyyy") ?? "—")</td>
                                        <td>@(item.DataAnalise?.ToString("dd/MM/yyyy") ?? "—")</td>
                                        <td>@Html.DisplayStatusFor(x => item.Status)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        (function () {
            var canvas = document.getElementById('barChart');
            var tema = window.knsTemaComponentes;
            var cores = tema ? tema.opcoesGrafico() : { grade: '#DDE7EF', texto: '#6C8394' };

            if (canvas) {
                var grafico = new Chart(canvas.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: ['Liberados', 'Alerta', 'Bloqueados', 'Aguardando'],
                        datasets: [{
                            label: 'Solicitações',
                            data: [@liberados, @alerta, @bloqueados, @solicitados],
                            backgroundColor: ['#1F9D57', '#C98A00', '#C7442F', '#2B6CB0'],
                            borderWidth: 0,
                            borderRadius: 6,
                            maxBarThickness: 54
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        legend: { display: false },
                        scales: {
                            yAxes: [{
                                ticks: { beginAtZero: true, precision: 0, fontColor: cores.texto },
                                gridLines: { color: cores.grade, zeroLineColor: cores.grade }
                            }],
                            xAxes: [{
                                ticks: { fontColor: cores.texto },
                                gridLines: { display: false }
                            }]
                        }
                    }
                });

                // Canvas não acompanha a troca de variável CSS; precisa ser redesenhado.
                if (tema) { tema.registrarGrafico(grafico); }
            }

            document.querySelectorAll('.table-row').forEach(function (linha) {
                linha.addEventListener('click', function () {
                    if (this.dataset.url) {
                        window.location.href = this.dataset.url;
                    }
                });
            });
        })();
    </script>
}
