<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewData["Title"] - GeotecnologiaKNS</title>
    <link rel="stylesheet" href="~/vendors/mdi/css/materialdesignicons.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/vendors/base/vendor.bundle.base.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/images/favicon.png" />
    @* Sem tema aqui de propósito: as telas de fora do sistema (login e o
       primeiro acesso) têm identidade própria e ficam sempre claras. O
       _temaScript, no layout interno, também herdava o tema do sistema
       operacional — quem usa o Windows no escuro abria o login escurecido
       sem nunca ter escolhido isso. *@
</head>
<body>
    @RenderBody()
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/vendors/base/vendor.bundle.base.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
