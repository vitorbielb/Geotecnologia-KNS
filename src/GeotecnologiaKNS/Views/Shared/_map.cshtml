@using Microsoft.Extensions.Options
@inject IOptions<GoogleMapsOptions> googleMaps
@inject IPropriedadeRepository propriedadeRepository

@{
    var maps = googleMaps.Value;

    var propriedades = propriedadeRepository
        .ObterParaMapa()
        .Select(p => new
        {
            nome = p.NomePropriedade,
            municipio = p.Municipio,
            lat = p.Latitude,
            lng = p.Longitude,
            perimetro = p.PerimetroGeoJson
        })
        .ToList();

    var comCoordenadas = propriedades.Where(p => p.lat != 0 || p.lng != 0).ToList();

    var centerLat = comCoordenadas.Count > 0 ? comCoordenadas.Average(p => p.lat) : maps.DefaultLat;
    var centerLng = comCoordenadas.Count > 0 ? comCoordenadas.Average(p => p.lng) : maps.DefaultLng;
}

<div class="card-body">
    <h4 class="card-title">Propriedades monitoradas</h4>

    @if (string.IsNullOrWhiteSpace(maps.ApiKey))
    {
        <div class="alert alert-warning mb-0">
            Mapa indisponível: a chave da API do Google Maps não está configurada
            (<code>GoogleMaps:ApiKey</code>).
        </div>
    }
    else
    {
        <div id="map" style="height: 380px;"></div>

        <script type="text/javascript">
            var propriedadesMonitoradas = @Json.Serialize(propriedades);

            function initMap() {
                const map = new google.maps.Map(document.getElementById("map"), {
                    zoom: @(comCoordenadas.Count > 0 ? 6 : 4),
                    center: { lat: @centerLat.ToString(System.Globalization.CultureInfo.InvariantCulture), lng: @centerLng.ToString(System.Globalization.CultureInfo.InvariantCulture) },
                    disableDefaultUI: true,
                    mapTypeId: "terrain",
                });

                // Mapa segue o tema: sem isso vira uma mancha clara numa tela escura.
                if (window.knsTemaComponentes) { window.knsTemaComponentes.registrarMapa(map); }

                const infoWindow = new google.maps.InfoWindow();
                const avulsos = [];

                window.knsPerimetro.estilizar(map);

                propriedadesMonitoradas.forEach(function (propriedade) {
                    // O perímetro entra sempre que existir, mas sozinho não
                    // resolve neste mapa: com propriedades em estados
                    // diferentes o enquadramento desce a zoom 5, e nesse zoom
                    // uma fazenda inteira tem menos de um pixel. Quem olha o
                    // painel quer saber onde elas estão — por isso o marcador
                    // vem junto, e o polígono aparece quando se aproxima.
                    //
                    // O acrescentar não lança: perímetro ilegível em uma
                    // propriedade derrubava o laço e o painel ficava vazio.
                    if (propriedade.perimetro) {
                        window.knsPerimetro.acrescentar(map, propriedade.perimetro);
                    }

                    if (propriedade.lat === 0 && propriedade.lng === 0) {
                        return;
                    }

                    const centro = { lat: propriedade.lat, lng: propriedade.lng };
                    avulsos.push(centro);

                    const marcador = new google.maps.Marker({
                        position: centro,
                        map: map,
                        title: propriedade.nome,
                    });

                    marcador.addListener("click", function () {
                        infoWindow.setContent(propriedade.nome + " - " + propriedade.municipio);
                        infoWindow.open(map, marcador);
                    });
                });

                // Enquadra em tudo que entrou. O centro médio com zoom fixo
                // deixava de fora as propriedades mais distantes — e indústria
                // que compra em dois estados tem exatamente esse caso.
                window.knsPerimetro.enquadrarTudo(map, avulsos);
            }

            window.initMap = initMap;
        </script>

        <script src="https://maps.googleapis.com/maps/api/js?key=@maps.ApiKey&callback=initMap&v=weekly" defer></script>
    }
</div>
