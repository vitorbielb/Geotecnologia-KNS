@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

@{
    var logoIndustria = User.Identity is null
        ? string.Empty
        : User.Identity.GetLogoPath(Context.Request.Path);

    var nomeIndustria = User.Identity is null
        ? string.Empty
        : User.Identity.GetIndustria();
}

<nav class="navbar col-lg-12 col-12 p-0 fixed-top d-flex flex-row">
    <div class="navbar-brand-wrapper d-flex justify-content-center">
        <div class="navbar-brand-inner-wrapper d-flex justify-content-between align-items-center w-100">
            <a class="navbar-brand brand-logo" href="@Url.Action("Index", "Home")">
                <img src="~/images/logo.png" alt="KNS Ambiental — Geotecnologia" />
            </a>
            <a class="navbar-brand brand-logo-mini" href="@Url.Action("Index", "Home")">
                <img src="~/images/logo.png" alt="KNS" />
            </a>
            <button class="navbar-toggler navbar-toggler align-self-center" type="button" data-toggle="minimize">
                <span class="mdi mdi-sort-variant"></span>
            </button>
        </div>
    </div>

    <div class="navbar-menu-wrapper d-flex align-items-center justify-content-end">
        @if (SignInManager.IsSignedIn(User))
        {
            @* Contexto do tenant sempre visível: num sistema multi-indústria,
               operar na empresa errada é um erro caro e silencioso. *@
            <div class="kns-tenant">
                @if (!string.IsNullOrWhiteSpace(logoIndustria))
                {
                    <img class="kns-tenant__logo" src="@logoIndustria" alt="" />
                }
                else
                {
                    <span class="kns-tenant__logo d-flex align-items-center justify-content-center">
                        <i class="mdi mdi-domain" style="color: var(--kns-verde-escuro);"></i>
                    </span>
                }
                <span>
                    <span class="kns-tenant__rotulo d-block">Indústria</span>
                    <span class="kns-tenant__nome d-block">@nomeIndustria</span>
                </span>
            </div>
        }

        <ul class="navbar-nav navbar-nav-right">
            @if (SignInManager.IsSignedIn(User))
            {
                <li class="nav-item nav-profile dropdown">
                    <a class="nav-link dropdown-toggle d-flex align-items-center" href="#"
                       data-bs-toggle="dropdown" id="profileDropdown">
                        <i class="mdi mdi-account-circle-outline me-2"
                           style="font-size: 22px; color: var(--kns-ardosia);"></i>
                        <span class="nav-profile-name">@User.Identity!.Name</span>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end navbar-dropdown" aria-labelledby="profileDropdown">
                        <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                            <i class="mdi mdi-account-cog-outline text-primary"></i>
                            Minha conta
                        </a>
                        <div class="dropdown-divider"></div>
                        <form class="px-2" asp-area="Identity" asp-page="/Account/Logout"
                              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                            <button type="submit" class="dropdown-item ps-2 border-0 bg-transparent">
                                <i class="mdi mdi-logout text-primary"></i>
                                Sair
                            </button>
                        </form>
                    </div>
                </li>
            }
            else
            {
                <li class="nav-item">
                    <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Entrar</a>
                </li>
            }
        </ul>

        <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center" type="button" data-toggle="offcanvas">
            <span class="mdi mdi-menu"></span>
        </button>
    </div>
</nav>
