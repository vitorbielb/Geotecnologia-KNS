<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewData["Title"] - GeotecnologiaKNS</title>
    <link rel="stylesheet" href="~/vendors/mdi/css/materialdesignicons.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/vendors/base/vendor.bundle.base.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/images/favicon.png" />
    <partial name="_temaScript" />
</head>
<body>
    @* Token de antifalsificação para as chamadas AJAX (envio e exclusão de
       documentos). Fica no layout, e não em cada partial de upload, porque o
       script é um só e vale para todas as telas. *@
    @Html.AntiForgeryToken()

    <div class="container-scroller">
        <partial name="_navbar"></partial>

        <div class="container-fluid page-body-wrapper">
            <partial name="_sidebar"></partial>
            <div class="main-panel">
                <div class="content-wrapper">
                    <main role="main" class="pb-3">
                        @RenderBody()
                    </main>
                </div>
                <partial name="_footer"></partial>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/vendors/base/vendor.bundle.base.js"></script>
    <script src="~/vendors/chart.js/Chart.min.js"></script>
    <script src="~/js/off-canvas.js" asp-append-version="true"></script>
    <script src="~/js/hoverable-collapse.js" asp-append-version="true"></script>
    <script src="~/js/template.js" asp-append-version="true"></script>
    <script src="~/js/file-upload.js" asp-append-version="true"></script>
    <script src="~/js/tema.js" asp-append-version="true"></script>
    <script src="~/js/tema-componentes.js" asp-append-version="true"></script>
    <script src="~/js/perimetro-mapa.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
