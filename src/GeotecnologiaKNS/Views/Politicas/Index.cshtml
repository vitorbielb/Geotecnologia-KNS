@model GeotecnologiaKNS.Models.PoliticaTenant

@{
    ViewData["Title"] = "Regras de conformidade";
    var personalizada = ViewBag.Personalizada as bool? ?? false;

    string NomeTipo(GeotecnologiaKNS.Geo.Entities.TipoCamada tipo) => tipo switch
    {
        GeotecnologiaKNS.Geo.Entities.TipoCamada.EmbargoAmbiental => "Embargo ambiental",
        GeotecnologiaKNS.Geo.Entities.TipoCamada.TerraIndigena => "Terra Indígena",
        GeotecnologiaKNS.Geo.Entities.TipoCamada.UnidadeConservacao => "Unidade de Conservação",
        GeotecnologiaKNS.Geo.Entities.TipoCamada.TerritorioQuilombola => "Território quilombola",
        GeotecnologiaKNS.Geo.Entities.TipoCamada.AssentamentoRural => "Assentamento rural",
        GeotecnologiaKNS.Geo.Entities.TipoCamada.DesmatamentoConsolidado => "Desmatamento consolidado",
        GeotecnologiaKNS.Geo.Entities.TipoCamada.AlertaDesmatamento => "Alerta de desmatamento",
        GeotecnologiaKNS.Geo.Entities.TipoCamada.Bioma => "Bioma",
        GeotecnologiaKNS.Geo.Entities.TipoCamada.OutroPerimetro => "Outro perímetro",
        _ => tipo.ToString()
    };
}

<div class="kns-cabecalho">
    <div>
        <h1 class="kns-cabecalho__titulo">Regras de conformidade</h1>
        <p class="kns-cabecalho__sub">
            Definem o que libera, alerta ou bloqueia uma compra nas análises desta indústria.
        </p>
    </div>
    <div class="kns-trilha">
        <i class="mdi mdi-home-outline"></i>
        <span>Configurações</span>
        <span>/</span>
        <span class="kns-trilha__atual">Regras</span>
    </div>
</div>

@if (TempData["Sucesso"] is string sucesso)
{
    <div class="alert alert-success">@sucesso</div>
}

@if (!personalizada)
{
    <div class="alert alert-info">
        <strong>Sua indústria usa o protocolo padrão.</strong>
        Os cortes abaixo são herdados e valem enquanto nenhuma regra própria for definida.
        Adote-o como política própria para poder ajustá-lo — o padrão original não será afetado.
        <form asp-action="AdotarPadrao" method="post" class="mt-3">
            <button type="submit" class="btn btn-primary">Adotar como política própria</button>
        </form>
    </div>
}

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="card-title mb-0">@Model.Nome</h4>
            @if (personalizada)
            {
                <span class="text-muted">Atualizada em @Model.AtualizadaEm.ToString("dd/MM/yyyy HH:mm")</span>
            }
        </div>

        <p class="text-muted">
            Uma regra dispara quando a sobreposição atinge a área <em>ou</em> o percentual informado.
            Com ambos em zero, qualquer sobreposição dispara. O ano mínimo aplica o corte temporal
            e só vale para camadas datadas, como o PRODES.
        </p>

        <form asp-action="Salvar" method="post">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Regra</th>
                            <th>Camada</th>
                            <th>Consequência</th>
                            <th class="text-end">Área mín. (ha)</th>
                            <th class="text-end">% mín.</th>
                            <th class="text-end">Ano mín.</th>
                            <th class="text-center">Ativa</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Regras.Count; i++)
                        {
                            var regra = Model.Regras[i];

                            <tr>
                                <td>
                                    <input type="hidden" name="regras[@i].Id" value="@regra.Id" />
                                    <strong>@regra.Codigo</strong><br />
                                    <span class="text-muted">@regra.Descricao</span>
                                    @if (!string.IsNullOrWhiteSpace(regra.Fundamento))
                                    {
                                        <br />

                                        <small class="text-muted">@regra.Fundamento</small>
                                    }
                                </td>
                                <td>@NomeTipo(regra.Tipo)</td>
                                <td>
                                    <select name="regras[@i].Severidade" class="form-control form-control-sm"
                                            disabled="@(!personalizada)">
                                        <option value="2" selected="@(regra.Severidade == 2)">Bloqueia</option>
                                        <option value="1" selected="@(regra.Severidade == 1)">Alerta</option>
                                        <option value="0" selected="@(regra.Severidade == 0)">Só registra</option>
                                    </select>
                                </td>
                                <td>
                                    <input type="number" step="0.01" min="0" class="form-control form-control-sm text-end"
                                           name="regras[@i].AreaMinimaHa" value="@regra.AreaMinimaHa.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                           disabled="@(!personalizada)" />
                                </td>
                                <td>
                                    <input type="number" step="0.01" min="0" max="100" class="form-control form-control-sm text-end"
                                           name="regras[@i].PercentualMinimo" value="@regra.PercentualMinimo.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                           disabled="@(!personalizada)" />
                                </td>
                                <td>
                                    <input type="number" step="1" class="form-control form-control-sm text-end"
                                           name="regras[@i].AnoMinimo" value="@regra.AnoMinimo"
                                           disabled="@(!personalizada)" />
                                </td>
                                <td class="text-center">
                                    <input type="hidden" name="regras[@i].Ativa" value="false" />
                                    <input type="checkbox" name="regras[@i].Ativa" value="true"
                                           checked="@regra.Ativa" disabled="@(!personalizada)" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (personalizada)
            {
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <span class="text-muted">
                        As alterações valem para as próximas análises. Laudos já emitidos mantêm as regras da época.
                    </span>
                    <button type="submit" class="btn btn-primary gradient-button">Salvar regras</button>
                </div>
            }
        </form>
    </div>
</div>
