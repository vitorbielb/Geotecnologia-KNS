@{
    // Os ícones SVG inline foram trocados por Material Design Icons, que já é
    // carregado pelo layout: o SVG anterior trazia fill fixo e não acompanhava
    // os estados do menu, além de repetir ~2 KB de markup por item.
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    string Ativo(string alvoController, params string[] alvoActions) =>
        controller.Equals(alvoController, StringComparison.OrdinalIgnoreCase)
        && (alvoActions.Length == 0 || alvoActions.Any(a => action.StartsWith(a, StringComparison.OrdinalIgnoreCase)))
            ? "active"
            : string.Empty;

    bool GrupoAberto(params string[] controllers) =>
        controllers.Any(c => controller.Equals(c, StringComparison.OrdinalIgnoreCase));
}

<nav class="sidebar sidebar-offcanvas" id="sidebar">
    <ul class="nav">

        <li class="nav-item">
            <a class="nav-link @Ativo("Home")" href="@Url.Action("Index", "Home")">
                <i class="mdi mdi-view-dashboard-outline menu-icon"></i>
                <span class="menu-title">Painel</span>
            </a>
        </li>

        <li class="kns-secao">Monitoramento</li>

        <li class="nav-item">
            <a class="nav-link @Ativo("Produtores", "Index", "Create", "Edit", "Details", "Delete")"
               href="@Url.Action("Index", "Produtores")">
                <i class="mdi mdi-account-tie-outline menu-icon"></i>
                <span class="menu-title">Produtores</span>
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link @Ativo("Propriedades", "Index", "Create", "Edit", "Details", "Delete")"
               href="@Url.Action("Index", "Propriedades")">
                <i class="mdi mdi-map-outline menu-icon"></i>
                <span class="menu-title">Imóveis rurais</span>
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link @Ativo("Solicitacoes", "Index", "Create", "Details")"
               href="@Url.Action("Index", "Solicitacoes")">
                <i class="mdi mdi-clipboard-text-outline menu-icon"></i>
                <span class="menu-title">Solicitações</span>
            </a>
        </li>

        <li class="kns-secao">Análise</li>

        <li class="nav-item">
            <a class="nav-link @Ativo("Solicitacoes", "Analise", "Edit")"
               href="@Url.Action("Analise", "Solicitacoes")">
                <i class="mdi mdi-shield-search menu-icon"></i>
                <span class="menu-title">Análises</span>
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link @Ativo("Cartografias")" href="@Url.Action("Index", "Cartografias")">
                <i class="mdi mdi-layers-outline menu-icon"></i>
                <span class="menu-title">Cartografias</span>
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="collapse" href="#ui-validacao"
               aria-expanded="@(GrupoAberto("Produtores", "Propriedades") && action.StartsWith("Analise", StringComparison.OrdinalIgnoreCase) ? "true" : "false")"
               aria-controls="ui-validacao">
                <i class="mdi mdi-check-decagram-outline menu-icon"></i>
                <span class="menu-title">Validações</span>
                <i class="menu-arrow"></i>
            </a>
            <div class="collapse @(action.StartsWith("Analise", StringComparison.OrdinalIgnoreCase) && GrupoAberto("Produtores", "Propriedades") ? "show" : "")" id="ui-validacao">
                <ul class="nav flex-column sub-menu">
                    <li class="nav-item">
                        <a class="nav-link @Ativo("Produtores", "Analise")" href="@Url.Action("Analise", "Produtores")">
                            Produtores
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Ativo("Propriedades", "Analise")" href="@Url.Action("Analise", "Propriedades")">
                            Imóveis rurais
                        </a>
                    </li>
                </ul>
            </div>
        </li>

        <li class="kns-secao">Administração</li>

        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="collapse" href="#ui-admin"
               aria-expanded="@(GrupoAberto("Industrias", "Roles", "Users") ? "true" : "false")"
               aria-controls="ui-admin">
                <i class="mdi mdi-cog-outline menu-icon"></i>
                <span class="menu-title">Configurações</span>
                <i class="menu-arrow"></i>
            </a>
            <div class="collapse @(GrupoAberto("Industrias", "Roles", "Users") ? "show" : "")" id="ui-admin">
                <ul class="nav flex-column sub-menu">
                    <li class="nav-item">
                        <a class="nav-link @Ativo("Industrias")" href="@Url.Action("Index", "Industrias")">
                            Indústrias
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Ativo("Roles")" href="@Url.Action("Index", "Roles")">
                            Funções e permissões
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Ativo("Users")" href="@Url.Action("Index", "Users")">
                            Usuários
                        </a>
                    </li>
                </ul>
            </div>
        </li>

    </ul>
</nav>
