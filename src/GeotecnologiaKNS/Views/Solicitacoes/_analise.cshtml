@using GeotecnologiaKNS.Views
@model GeotecnologiaKNS.Models.AnaliseAutomatica

@{
    string SeveridadeCss(int severidade) => severidade switch
    {
        2 => "danger",
        1 => "warning",
        _ => "secondary"
    };

    string SeveridadeTexto(int severidade) => severidade switch
    {
        2 => "BLOQUEIO",
        1 => "ALERTA",
        _ => "INFORMATIVO"
    };
}

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h4 class="card-title mb-0">Análise automática</h4>

            <div class="d-flex align-items-center gap-2">
                @if (Model.Situacao == SituacaoAnalise.Concluida)
                {
                    <a class="btn btn-outline-primary btn-sm"
                       href="@Url.Action("Laudo", "Solicitacoes", new { id = Model.Id })"
                       target="_blank" rel="noopener">
                        <i class="mdi mdi-file-pdf-box"></i>
                        Baixar laudo
                    </a>

                    <form method="post"
                          action="@Url.Action("Reanalisar", "Solicitacoes", new { id = Model.SolicitacaoId })"
                          class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-secondary btn-sm"
                                title="Executa uma análise nova contra as bases de hoje. A anterior fica gravada.">
                            <i class="mdi mdi-refresh"></i>
                            Reexecutar
                        </button>
                    </form>
                }
                @Html.DisplayStatus(Model.Resultado)
            </div>
        </div>

        <p class="text-muted mt-2 mb-3">
            @Model.Politica — executada em @Model.IniciadaEm.ToString("dd/MM/yyyy HH:mm")
            @if (Model.AreaImovelHa > 0)
            {
                <text>· imóvel de @Model.AreaImovelHa.ToString("N2") ha</text>
            }
        </p>

        @{
            var basesEm = ViewBag.BasesAtualizadasEm as DateTime?;
            var basesMudaram = basesEm.HasValue
                               && Model.ConcluidaEm.HasValue
                               && basesEm.Value > Model.ConcluidaEm.Value;
        }
        @if (basesMudaram)
        {
            @* Dito aqui, e não deixado para quem cruzar a data da execução com
               a data de carga de cada base: o resultado continua verdadeiro
               sobre o dia em que foi apurado, e deixou de descrever hoje. *@
            <div class="alert alert-info d-flex align-items-start gap-2">
                <i class="mdi mdi-database-clock mt-1"></i>
                <div>
                    <strong>As bases mudaram depois desta análise.</strong>
                    A carga mais recente das camadas que cobrem este imóvel é de
                    @basesEm!.Value.ToString("dd/MM/yyyy"), posterior à execução.
                    O resultado abaixo continua verdadeiro sobre o dia em que foi
                    apurado — uma nova execução refletiria o que há nas bases hoje.
                </div>
            </div>
        }

        @if (Model.Situacao is SituacaoAnalise.Pendente or SituacaoAnalise.Processando)
        {
            <div class="alert alert-info d-flex align-items-center gap-2 mb-0" id="kns-analise-andamento">
                <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                <div>
                    <strong>Análise em andamento.</strong>
                    O perímetro está sendo cruzado com as camadas de referência.
                    @if (Model.Tentativas > 1)
                    {
                        <text>Tentativa @Model.Tentativas.</text>
                    }
                    Esta página se atualiza sozinha quando terminar.
                </div>
            </div>

            @* Recarrega em vez de consultar um endpoint de estado: são poucos
               segundos de espera e uma tela só, e um endpoint de sondagem seria
               mais superfície para manter do que o problema justifica. *@
            <script>
                setTimeout(function () { window.location.reload(); }, 4000);
            </script>

            return;
        }

        @* Cobertura parcial vem antes de tudo: um laudo sem ocorrências se lê
           como aprovação, e é exatamente aí que a omissão engana. *@
        @{
            // O veredito distingue os dois casos: o motor só devolve LIBERADO
            // quando nenhuma regra capaz de decidir ficou sem avaliar. Então
            // resultado liberado com cobertura parcial significa que as lacunas
            // são todas informativas — e aí a tela não pode dizer "não é uma
            // liberação" logo abaixo de um selo verde escrito Liberado.
            var lacunasDecidem = Model.Resultado != Status.Liberado;
        }

        @if (Model.Situacao == SituacaoAnalise.Concluida && !Model.CoberturaCompleta)
        {
            <div class="alert @(lacunasDecidem ? "alert-warning" : "alert-secondary")">
                @if (lacunasDecidem)
                {
                    <strong>Verificação incompleta.</strong>
                    <text>
                        As regras abaixo não puderam ser aplicadas, e por isso o resultado
                        não é uma liberação. O que não aparece nesta análise não foi
                        verificado — não é ausência de restrição.
                    </text>
                }
                else
                {
                    <strong>Verificação parcial.</strong>
                    <text>
                        As regras abaixo não puderam ser aplicadas. Elas são informativas
                        na política desta indústria, então não alteram o resultado — mas o
                        que elas examinam não foi verificado.
                    </text>
                }
                @if (!string.IsNullOrWhiteSpace(Model.RegrasNaoAvaliadas))
                {
                    <ul class="mb-0 mt-2">
                        @foreach (var regra in Model.RegrasNaoAvaliadas.Split('\n',
                            StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                        {
                            <li>@regra</li>
                        }
                    </ul>
                }
            </div>
        }

        @if (Model.Situacao == SituacaoAnalise.Falhou)
        {
            <div class="alert alert-danger">
                <strong>A análise não pôde ser concluída.</strong><br />
                @Model.Erro
                <hr />
                A solicitação permanece sem liberação até que a causa seja resolvida
                e a análise seja executada novamente.
            </div>
        }
        else if (Model.Ocorrencias.Count == 0 && Model.CoberturaCompleta)
        {
            <div class="alert alert-success mb-0">
                Nenhuma sobreposição restritiva encontrada nas camadas verificadas.
            </div>
        }
        else if (Model.Ocorrencias.Count == 0 && lacunasDecidem)
        {
            <div class="alert alert-info mb-0">
                Nenhuma sobreposição nas camadas disponíveis. O resultado não é uma
                liberação — veja acima o que ficou sem verificação.
            </div>
        }
        else if (Model.Ocorrencias.Count == 0)
        {
            <div class="alert alert-success mb-0">
                Nenhuma sobreposição restritiva encontrada nas camadas verificadas.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Severidade</th>
                            <th>Regra</th>
                            <th>Camada</th>
                            <th>Feição</th>
                            <th class="text-end">Sobreposição</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ocorrencia in Model.Ocorrencias.OrderByDescending(o => o.Severidade)
                                                                     .ThenByDescending(o => o.AreaSobrepostaHa))
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-@SeveridadeCss(ocorrencia.Severidade)">
                                        @SeveridadeTexto(ocorrencia.Severidade)
                                    </span>
                                </td>
                                <td>
                                    <strong>@ocorrencia.CodigoRegra</strong><br />
                                    <span class="text-muted">@ocorrencia.Descricao</span>
                                    @if (!string.IsNullOrWhiteSpace(ocorrencia.Fundamento))
                                    {
                                        <br />

                                        <small class="text-muted">@ocorrencia.Fundamento</small>
                                    }
                                </td>
                                <td>
                                    @ocorrencia.Camada<br />
                                    <small class="text-muted">@ocorrencia.Origem</small>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(ocorrencia.Rotulo) ? "-" : ocorrencia.Rotulo)</td>
                                <td class="text-end">
                                    @ocorrencia.AreaSobrepostaHa.ToString("N2") ha<br />
                                    <small class="text-muted">@ocorrencia.PercentualDoImovel.ToString("N2")% do imóvel</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.CamadasVerificadas))
        {
            <details class="mt-3">
                <summary class="text-muted">Camadas verificadas nesta análise</summary>
                <pre class="mt-2 text-muted" style="white-space: pre-wrap; font-size: 0.85rem;">@Model.CamadasVerificadas</pre>
            </details>
        }
    </div>
</div>
